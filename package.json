{
  "name": "dsh-whale-animation",
  "version": "0.4.0",
  "description": "Reactive six-state whale animation director for the DeepSeek Harness Web turn status.",
  "license": "MIT",
  "author": "LeemanCheung",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "assets",
    "docs",
    "lib",
    "src",
    "scripts/browser-smoke.html",
    "scripts/build-client.mjs",
    "scripts/build-whale-assets.py",
    "scripts/check-browser.sh",
    "scripts/check-readme-assets.py",
    "scripts/check.mjs",
    "scripts/whale_assets/*.py",
    "cordis.patch.yml",
    "CHANGELOG.md",
    "README.md",
    "README.zh-CN.md",
    "LICENSE",
    "NOTICE.md"
  ],
  "keywords": [
    "dsh",
    "deepseek-harness",
    "dsh-plugin",
    "cordis",
    "web-ui",
    "animation",
    "whale"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/LeemanCheung/dsh-whale-animation.git"
  },
  "bugs": {
    "url": "https://github.com/LeemanCheung/dsh-whale-animation/issues"
  },
  "homepage": "https://github.com/LeemanCheung/dsh-whale-animation#readme",
  "engines": {
    "node": ">=20"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-runtime"
      ],
      "platform": "web"
    }
  },
  "scripts": {
    "build": "node scripts/build-client.mjs",
    "build:assets": "python scripts/build-whale-assets.py",
    "check": "node scripts/check.mjs && python scripts/check-readme-assets.py",
    "check:browser": "bash scripts/check-browser.sh",
    "verify": "npm run build && npm run check"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-client-runtime": "^0.1.0-rc.6"
  }
}
